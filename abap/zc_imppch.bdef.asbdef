projection;
strict ( 2 );

define behavior for ZC_IMPPCH alias IMPPCH
{
  use create;
  use update;
  use delete;
  use association Itens { create; }
  use association Moeda { create; }
  use association Despacho { create; }
  use association Demurrage { create; }
  use association Previsao { create; }
  use association LoteSerie { create; }
}

define behavior for ZC_IMPPCH_PCH1 alias PCH1
{
  use update;
  use delete;
  use association _Parent;
}

