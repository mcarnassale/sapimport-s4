@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Processo de importacao'
define root view entity ZR_IMPPCH
  as select from zimppch
  composition [0..*] of ZR_IMPPCH_PCH1 as Itens
  composition [0..*] of ZR_IMPPCH_PCH2 as Moeda
  composition [0..*] of ZR_IMPPCH_PCH3 as Despacho
  composition [0..*] of ZR_IMPPCH_PCH4 as Demurrage
  composition [0..*] of ZR_IMPPCH_PCH5 as Previsao
  composition [0..*] of ZR_IMPPCH_PCH6 as LoteSerie
{
  key sap_uuid as SAP_UUID,
  docentry as DocEntry,
  accdesp as AccDesp,
  aduaneiro as Aduaneiro,
  agentcode as AgentCode,
  agentname as AgentName,
  antidump as AntiDump,
  atcentry as AtcEntry,
  bldate as BLDate,
  blnum as BLNum,
  bloqadp as BloqAdp,
  bloqadu as BloqAdu,
  bloqcap as BloqCap,
  bloqcol as BloqCol,
  bloqout as BloqOut,
  bloqseg as BloqSeg,
  bloqsis as BloqSis,
  bondedwhs as BondedWhs,
  bplid as BPLId,
  canal as Canal,
  canceled as Canceled,
  capatazia as Capatazia,
  chaveacesso as ChaveAcesso,
  collect as Collect,
  courrier as Courrier,
  ctrc as CTRC,
  curradp as CurrAdp,
  curradu as CurrAdu,
  currcol as CurrCol,
  currout as CurrOut,
  currpre as CurrPre,
  currseg as CurrSeg,
  desovadt as DesovaDt,
  didate as DIDate,
  dinum as DINum,
  docdate as DocDate,
  dscrption as Dscrption,
  dtcanal as DtCanal,
  dtchegfab as DtChegFab,
  dtdesenb as DtDesenb,
  dtlibera as DtLibera,
  dtpresen as DtPresen,
  embal as Embal,
  entrepdt as EntrepDt,
  entrpost as Entrpost,
  freightwdr as FreightWdr,
  fshipdate as fShipDate,
  gldate as GLDate,
  goodstype as GoodsType,
  icmspre as ICMSPre,
  inccanc as IncCanc,
  incoterm as Incoterm,
  infreinv as InFreInv,
  inoutinv as InOutInv,
  inseginv as InSegInv,
  invoices as Invoices,
  issue as Issue,
  layout as Layout,
  mandate as ManDate,
  metoadp as MetoAdp,
  metoadu as MetoAdu,
  metocap as MetoCap,
  metocol as MetoCol,
  metoout as MetoOut,
  metopre as MetoPre,
  metoseg as MetoSeg,
  metosis as MetoSis,
  modal as Modal,
  numped as NumPed,
  oldvalue as OldValue,
  onhold as OnHold,
  outros as Outros,
  pedpai as PedPai,
  pendinggl as PendingGL,
  pesobto as PesoBto,
  pesoliq as PesoLiq,
  prepaid as Prepaid,
  procnum as ProcNum,
  profit as Profit,
  pvdtchega as PvDtChega,
  pvdtchgfa as PvDtChgFa,
  pvdtembar as PvDtEmbar,
  pvdtpres as PvDtPres,
  qdevol as QdeVol,
  qtyboad as QtyBoad,
  ratedate as RateDate,
  remaksship as RemaksShip,
  remodedt as RemoDeDt,
  remoendt as RemoEnDt,
  seguro as Seguro,
  seladp as SelAdp,
  seladu as SelAdu,
  selcap as SelCap,
  selcol as SelCol,
  selected as Selected,
  selout as SelOut,
  selseg as SelSeg,
  selsis as SelSis,
  semvalor as SemValor,
