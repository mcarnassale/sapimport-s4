  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.151.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.table": {},
        "sap.ui.unified": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "acx.sapimport.s4.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "updateGroupId": "deferred",
          "groupProperties": {
            "deferred": {
              "submit": "API"
            }
          }
        }
      },
      "despcal": {
        "dataSource": "cboDespcal",
        "preload": false,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "implay": {
        "dataSource": "cboImplay",
        "preload": false,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "impicfg": {
        "dataSource": "cboImpicfg",
        "preload": false,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "impiprv": {
        "dataSource": "cboImpiprv",
        "preload": false,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "imppch": {
        "dataSource": "cboImppch",
        "preload": false,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "product": {
        "dataSource": "productService",
        "preload": false,
        "settings": {
          "defaultBindingMode": "OneWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "bp": {
        "dataSource": "businessPartnerService",
        "preload": false,
        "settings": {
          "defaultBindingMode": "OneWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "currency": {
        "dataSource": "cdsCurrency",
        "preload": false,
        "settings": {
          "defaultBindingMode": "OneWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "exchrate": {
        "dataSource": "cdsExchrate",
        "preload": false,
        "settings": {
          "defaultBindingMode": "OneWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "taxcode": {
        "dataSource": "cdsTaxcode",
        "preload": false,
        "settings": {
          "defaultBindingMode": "OneWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "glaccount": {
        "dataSource": "cdsGlaccount",
        "preload": false,
        "settings": {
          "defaultBindingMode": "OneWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "storloc": {
        "dataSource": "cdsStorloc",
        "preload": false,
        "settings": {
          "defaultBindingMode": "OneWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "expense": {
        "dataSource": "cboExpense",
        "preload": false,
        "settings": {
          "defaultBindingMode": "OneWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "usage": {
        "dataSource": "cboUsage",
        "preload": false,
        "settings": {
          "defaultBindingMode": "OneWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "filial": {
        "dataSource": "cboFilial",
        "preload": false,
        "settings": {
          "defaultBindingMode": "OneWay",
          "defaultCountMode": "Inline",
          "useBatch": true
        }
      },
      "po": {
        "dataSource": "purchaseOrderService",
        "preload": false,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": false,
          "earlyRequests": false
        }
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "acx.sapimport.s4.view",
        "async": true,
        "viewPath": "acx.sapimport.s4.view"
      },
      "routes": [
        {
          "name": "RouteInicio",
          "pattern": ":?query:",
          "target": [
            "TargetInicio"
          ]
        },
        {
          "name": "RouteConfigs",
          "pattern": "configs",
          "target": [
            "TargetConfigs"
          ]
        },
        {
          "name": "RouteProcessosList",
          "pattern": "processos",
          "target": [
            "TargetProcessosList"
          ]
        },
        {
          "name": "RouteProcessosDetail",
          "pattern": "processos/{uuid}",
          "target": [
            "TargetProcessosDetail"
          ]
        },
        {
          "name": "RouteDespCalc",
          "pattern": "despcalc",
          "target": [
            "TargetDespCalc"
          ]
        },
        {
          "name": "RouteLayoutList",
          "pattern": "layout",
          "target": [
            "TargetLayoutList"
          ]
        },
        {
          "name": "RouteLayoutDetail",
          "pattern": "layout/{uuid}",
          "target": [
            "TargetLayoutDetail"
          ]
        },
        {
          "name": "RoutePreCalcList",
          "pattern": "precalc",
          "target": [
            "TargetPreCalcList"
          ]
        },
        {
          "name": "RoutePreCalcDetail",
          "pattern": "precalc/{uuid}",
          "target": [
            "TargetPreCalcDetail"
          ]
        }
      ],
      "targets": {
        "TargetBackendStatus": {
          "id": "BackendStatus",
          "name": "BackendStatus"
        },
        "TargetInicio": {
          "id": "Inicio",
          "name": "Inicio"
        },
        "TargetPreCalcList": {
          "id": "PreCalcList",
          "name": "PreCalcList"
        },
        "TargetPreCalcDetail": {
          "id": "PreCalcDetail",
          "name": "PreCalcDetail"
        },
        "TargetDespCalc": {
          "id": "DespCalc",
          "name": "DespCalc"
        },
        "TargetLayoutList": {
          "id": "LayoutList",
          "name": "LayoutList"
        },
        "TargetLayoutDetail": {
          "id": "LayoutDetail",
          "name": "LayoutDetail"
        },
        "TargetConfigs": {
          "id": "Configs",
          "name": "Configs"
        },
        "TargetProcessosList": {
          "id": "ProcessosList",
          "name": "ProcessosList"
        },
        "TargetProcessosDetail": {
          "id": "ProcessosDetail",
          "name": "ProcessosDetail"
        }
      }
    },
    "rootView": {
      "viewName": "acx.sapimport.s4.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
